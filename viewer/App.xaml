<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="SingularityMonitor.Viewer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularityMonitor.Viewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BrandSurface">#16222B</Color>
            <Color x:Key="BrandAccent">#2E9A8A</Color>
            <Color x:Key="BrandWarning">#D08A2D</Color>
            <Color x:Key="BrandText">#F5F8FA</Color>

            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurface}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
            <SolidColorBrush x:Key="BrandWarningBrush" Color="{StaticResource BrandWarning}" />
            <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandText}" />

            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PrimaryAction" TargetType="Button">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{StaticResource BrandAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
