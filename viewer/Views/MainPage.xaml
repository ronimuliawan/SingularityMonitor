<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="SingularityMonitor.Viewer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularityMonitor.Viewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#13212B" Offset="0" />
                <GradientStop Color="#0F171F" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer>
            <StackPanel Margin="28" Spacing="14">
                <TextBlock FontSize="30" Style="{StaticResource HeaderTextStyle}" Text="Singularity Monitor" />
                <TextBlock Foreground="#D4DCE2" Text="Low-footprint network telemetry for Windows 11." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="Interface" />
                    <ComboBox x:Name="InterfaceFilterComboBox" MinWidth="260" SelectionChanged="OnInterfaceFilterChanged" />
                    <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="Export Granularity" />
                    <ComboBox x:Name="ExportGranularityComboBox" MinWidth="140" />
                    <Button Click="OnExportCsvClicked" Content="Export CSV" />
                    <Button Click="OnExportJsonClicked" Content="Export JSON" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="IncludeSummaryCheckBox" Content="Summary buckets" IsChecked="True" />
                    <CheckBox x:Name="IncludeAppsCheckBox" Content="Apps" IsChecked="True" />
                    <CheckBox x:Name="IncludeInterfacesCheckBox" Content="Interfaces" IsChecked="True" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1F2A33" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#B5C5D3" Text="Today" />
                            <TextBlock x:Name="TodayTotalText" FontSize="22" Style="{StaticResource HeaderTextStyle}" Text="-" />
                            <TextBlock x:Name="TodaySplitText" Foreground="#BFD0DE" Text="-" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#1F2A33" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#B5C5D3" Text="This Week" />
                            <TextBlock x:Name="WeekTotalText" FontSize="22" Style="{StaticResource HeaderTextStyle}" Text="-" />
                            <TextBlock x:Name="WeekSplitText" Foreground="#BFD0DE" Text="-" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#1F2A33" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#B5C5D3" Text="This Month" />
                            <TextBlock x:Name="MonthTotalText" FontSize="22" Style="{StaticResource HeaderTextStyle}" Text="-" />
                            <TextBlock x:Name="MonthSplitText" Foreground="#BFD0DE" Text="-" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="Daemon Status" />
                        <TextBlock x:Name="StatusText" Foreground="#E2E9EE" Text="Loading daemon status..." TextWrapping="Wrap" />
                        <TextBlock x:Name="HelperStatusText" Foreground="#BFC9D2" Text="Helper ingestion status unknown." TextWrapping="Wrap" />
                        <ProgressBar x:Name="ImportProgressBar" Height="8" Maximum="100" Minimum="0" Value="0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnRefreshClicked" Content="Refresh" Style="{StaticResource PrimaryAction}" />
                            <Button Click="OnSummaryClicked" Content="Today Summary" />
                            <Button Click="OnStartHelperClicked" Content="Start Helper Loop" />
                            <Button Click="OnImportHistoryClicked" Content="Import 60 Days" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="Collector Settings" />

                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="#B5C5D3" Text="Poll interval (seconds)" />
                            <NumberBox Grid.Row="0" Grid.Column="1" x:Name="PollIntervalNumberBox" Minimum="15" Maximum="300" SmallChange="15" SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Foreground="#9AAEBE" Text="Hot-reloads in daemon; next poll uses this interval." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#B5C5D3" Text="Retention (days)" />
                            <NumberBox Grid.Row="1" Grid.Column="1" x:Name="RetentionDaysNumberBox" Minimum="0" Maximum="3650" SmallChange="30" SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Foreground="#9AAEBE" Text="0 keeps all local history." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#B5C5D3" Text="AFK idle threshold (seconds)" />
                            <NumberBox Grid.Row="2" Grid.Column="1" x:Name="AfkIdleThresholdNumberBox" Minimum="30" Maximum="3600" SmallChange="30" SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="#9AAEBE" Text="Used by upcoming AFK audit pipeline." TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnApplySettingsClicked" Content="Apply Settings" Style="{StaticResource PrimaryAction}" />
                            <Button Click="OnResetSettingsClicked" Content="Reset Defaults" />
                            <TextBlock x:Name="SettingsStatusText" Foreground="#BFD0DE" VerticalAlignment="Center" Text="" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="Collector Target" />
                        <TextBlock Foreground="#D4DCE2" Text="Steady-state memory target: under 3 MB (hard ceiling 5 MB)." TextWrapping="Wrap" />
                        <TextBlock x:Name="MemoryHintText" Foreground="{StaticResource BrandWarningBrush}" Text="Waiting for daemon metrics..." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="Top Apps" />
                            <TextBlock x:Name="TopAppsRangeText" Foreground="#BFD0DE" Text="(last 24h)" />
                            <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="Sort" />
                            <ComboBox x:Name="TopAppsSortComboBox" MinWidth="180" SelectionChanged="OnTopAppsSortChanged" />
                            <Button Click="OnRefreshAppsClicked" Content="Refresh Apps" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="From" />
                            <DatePicker x:Name="StartDatePicker" />
                            <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="To" />
                            <DatePicker x:Name="EndDatePicker" />
                            <Button Click="OnApplyRangeClicked" Content="Apply Range" />
                        </StackPanel>

                        <ListView x:Name="TopAppsList" Height="280" SelectionMode="Single" SelectionChanged="OnTopAppSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#E6EDF3" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="#BFD0DE" HorizontalAlignment="Right" Text="{Binding UsageText}" />
                                        </Grid>
                                        <TextBlock Foreground="#9AAEBE" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="App Detail" />
                            <TextBlock x:Name="AppDetailTitleText" Foreground="#BFD0DE" Text="Select an app from the list" TextTrimming="CharacterEllipsis" />
                            <TextBlock VerticalAlignment="Center" Foreground="#B5C5D3" Text="Granularity" />
                            <ComboBox x:Name="AppDetailGranularityComboBox" MinWidth="120" SelectionChanged="OnAppDetailGranularityChanged" />
                            <Button Click="OnRefreshAppDetailClicked" Content="Refresh Detail" />
                        </StackPanel>

                        <TextBlock x:Name="AppDetailSummaryText" Foreground="#D4DCE2" Text="Pick an app to view time series buckets." TextWrapping="Wrap" />

                        <ListView x:Name="AppDetailBucketsList" Height="220" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="#E6EDF3" Text="{Binding BucketLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="#9AAEBE" Text="{Binding SplitText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Foreground="#BFD0DE" HorizontalAlignment="Right" Text="{Binding UsageText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Background="#1F2A33" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="18" Style="{StaticResource HeaderTextStyle}" Text="Interface Breakdown" />
                            <TextBlock x:Name="InterfaceBreakdownRangeText" Foreground="#BFD0DE" Text="(selected range)" />
                            <Button Click="OnRefreshInterfaceBreakdownClicked" Content="Refresh Interfaces" />
                        </StackPanel>

                        <ListView x:Name="InterfaceBreakdownList" Height="220" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="#E6EDF3" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="#BFD0DE" HorizontalAlignment="Right" Text="{Binding UsageText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
